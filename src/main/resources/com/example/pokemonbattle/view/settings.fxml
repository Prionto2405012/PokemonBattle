<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="overlayRoot"
           xmlns="http://javafx.com/javafx/11.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.pokemonbattle.controller.SettingsController"
           styleClass="overlay-root"
           alignment="CENTER"
           stylesheets="@../css/common.css,@../css/settings_overlay.css"
           onMouseClicked="#onBackgroundClick">

    <!-- Card wrapper: constrained so X button can overhang the corner -->
    <StackPane maxWidth="640" pickOnBounds="false">

        <!-- ═══════════════ MAIN CARD ═══════════════ -->
        <VBox styleClass="overlay-container" spacing="0"
              onMouseClicked="#onCardClick">
            <padding>
                <Insets top="22" bottom="22" left="28" right="28"/>
            </padding>

            <!-- ── Title ── -->
            <Label text="SETTINGS" styleClass="overlay-title">
                <font><Font name="System Bold" size="26"/></font>
                <VBox.margin><Insets bottom="18"/></VBox.margin>
            </Label>

            <!-- ────────────── ScrollPane for all sections ────────────── -->
            <ScrollPane styleClass="settings-scroll" fitToWidth="true"
                        prefHeight="380" maxHeight="400" hbarPolicy="NEVER">
                <VBox styleClass="sections-container" spacing="0">

                    <!-- ══════════ SECTION: Game Sound ══════════ -->
                    <VBox styleClass="settings-section" spacing="10">
                        <!-- Row 1: label + toggle -->
                        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="section-row">
                            <Label text="Game Sound" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <!-- Toggle switch -->
                            <StackPane fx:id="gameSoundToggle"
                                       styleClass="toggle-switch"
                                       onMouseClicked="#onGameSoundToggle"
                                       prefWidth="48" prefHeight="26"
                                       minWidth="48" minHeight="26">
                                <Region fx:id="gameSoundTrack" styleClass="toggle-track"
                                        prefWidth="48" prefHeight="26"/>
                                <Region fx:id="gameSoundKnob" styleClass="toggle-knob"
                                        prefWidth="20" prefHeight="20"
                                        StackPane.alignment="CENTER_LEFT"
                                        translateX="3"/>
                            </StackPane>
                        </HBox>

                        <!-- Row 2: sound picker (disabled when off) -->
                        <VBox fx:id="gameSoundSubSection" styleClass="sub-section" spacing="6">
                            <Label text="Choose Sound" styleClass="sub-section-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label fx:id="gameSoundGen1" text="Gen 1" styleClass="option-btn"
                                       onMouseClicked="#onGameSoundGen1"/>
                                <Label fx:id="gameSoundGen2" text="Gen 2" styleClass="option-btn"
                                       onMouseClicked="#onGameSoundGen2"/>
                                <Label fx:id="gameSoundGen3" text="Gen 3" styleClass="option-btn"
                                       onMouseClicked="#onGameSoundGen3"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- section divider -->
                    <Region styleClass="section-divider"/>

                    <!-- ══════════ SECTION: Battle Sound ══════════ -->
                    <VBox styleClass="settings-section" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="section-row">
                            <Label text="Battle Sound" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane fx:id="battleSoundToggle"
                                       styleClass="toggle-switch"
                                       onMouseClicked="#onBattleSoundToggle"
                                       prefWidth="48" prefHeight="26"
                                       minWidth="48" minHeight="26">
                                <Region fx:id="battleSoundTrack" styleClass="toggle-track"
                                        prefWidth="48" prefHeight="26"/>
                                <Region fx:id="battleSoundKnob" styleClass="toggle-knob"
                                        prefWidth="20" prefHeight="20"
                                        StackPane.alignment="CENTER_LEFT"
                                        translateX="3"/>
                            </StackPane>
                        </HBox>

                        <VBox fx:id="battleSoundSubSection" styleClass="sub-section" spacing="6">
                            <Label text="Choose Sound" styleClass="sub-section-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label fx:id="battleSoundGen1" text="Gen 1" styleClass="option-btn"
                                       onMouseClicked="#onBattleSoundGen1"/>
                                <Label fx:id="battleSoundGen2" text="Gen 2" styleClass="option-btn"
                                       onMouseClicked="#onBattleSoundGen2"/>
                                <Label fx:id="battleSoundGen3" text="Gen 3" styleClass="option-btn"
                                       onMouseClicked="#onBattleSoundGen3"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- section divider -->
                    <Region styleClass="section-divider"/>

                    <!-- ══════════ SECTION: Show Move Animation ══════════ -->
                    <VBox styleClass="settings-section" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="section-row">
                            <Label text="Show Move Animation" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane fx:id="animationToggle"
                                       styleClass="toggle-switch"
                                       onMouseClicked="#onAnimationToggle"
                                       prefWidth="48" prefHeight="26"
                                       minWidth="48" minHeight="26">
                                <Region fx:id="animationTrack" styleClass="toggle-track"
                                        prefWidth="48" prefHeight="26"/>
                                <Region fx:id="animationKnob" styleClass="toggle-knob"
                                        prefWidth="20" prefHeight="20"
                                        StackPane.alignment="CENTER_LEFT"
                                        translateX="3"/>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <!-- section divider -->
                    <Region styleClass="section-divider"/>

                    <!-- ══════════ SECTION: Language ══════════ -->
                    <VBox styleClass="settings-section" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="section-row">
                            <Label text="Language" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox spacing="8" alignment="CENTER_RIGHT">
                                <Label fx:id="langEnglish" text="English" styleClass="option-btn"
                                       onMouseClicked="#onLangEnglish"/>
                                <Label fx:id="langJapanese" text="日本語" styleClass="option-btn"
                                       onMouseClicked="#onLangJapanese"/>
                            </HBox>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- ── Close button ── -->
            <HBox alignment="CENTER">
                <VBox.margin><Insets top="16"/></VBox.margin>
                <Button fx:id="closeButton" text="Close"
                        onAction="#onCloseButtonClick"
                        prefWidth="110"
                        styleClass="button-blue"/>
            </HBox>
        </VBox>

        <!-- X close button — pinned to the top-right corner of the card -->
        <Button fx:id="closeXButton" text="✕"
                onAction="#onCloseButtonClick"
                styleClass="close-x-button"
                StackPane.alignment="TOP_RIGHT"
                translateX="14" translateY="-14"/>

    </StackPane>
</StackPane>