<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="overlayRoot"
           xmlns="http://javafx.com/javafx/11.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.pokemonbattle.controller.SettingsController"
           styleClass="overlay-root"
           alignment="CENTER"
           stylesheets="@../css/common.css,@../css/settings_overlay.css"
           onMouseClicked="#onBackgroundClick">
    <StackPane maxWidth="540" maxHeight="600" pickOnBounds="false">
        <VBox alignment="TOP_CENTER" spacing="0" styleClass="overlay-container"
              onMouseClicked="#onCardClick">
            <padding>
                <Insets top="28" bottom="28" left="32" right="32"/>
            </padding>
            <Label text="Settings" styleClass="overlay-title">
                <VBox.margin><Insets bottom="20"/></VBox.margin>
            </Label>
            <VBox styleClass="settings-section" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Game Sound" styleClass="section-label"/>
                    <StackPane fx:id="gameSoundToggle" styleClass="toggle-switch,toggle-off"
                               onMouseClicked="#onGameSoundToggle">
                        <StackPane fx:id="gameSoundKnob" styleClass="toggle-knob"/>
                    </StackPane>
                </HBox>
                <VBox fx:id="gameSoundSubSection" styleClass="sub-section" spacing="6">
                    <Label text="Choose Sound" styleClass="sub-label"/>
                    <HBox spacing="8">
                        <Button fx:id="gameGen1Btn" text="Gen 1" styleClass="option-btn"
                                onAction="#onGameGenSelect" userData="1"/>
                        <Button fx:id="gameGen2Btn" text="Gen 2" styleClass="option-btn"
                                onAction="#onGameGenSelect" userData="2"/>
                        <Button fx:id="gameGen3Btn" text="Gen 3" styleClass="option-btn"
                                onAction="#onGameGenSelect" userData="3"/>
                    </HBox>
                </VBox>
                <VBox fx:id="gameSoundVolume" styleClass="volume"></VBox>
            </VBox>
            <StackPane styleClass="section-divider"><VBox.margin><Insets top="14" bottom="14"/></VBox.margin></StackPane>
            <VBox styleClass="settings-section" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Battle Sound" styleClass="section-label"/>
                    <StackPane fx:id="battleSoundToggle" styleClass="toggle-switch,toggle-off"
                               onMouseClicked="#onBattleSoundToggle">
                        <StackPane fx:id="battleSoundKnob" styleClass="toggle-knob"/>
                    </StackPane>
                </HBox>
                <VBox fx:id="battleSoundSubSection" styleClass="sub-section" spacing="6">
                    <Label text="Choose Sound" styleClass="sub-label"/>
                    <HBox spacing="8">
                        <Button fx:id="battleGen1Btn" text="Gen 1" styleClass="option-btn"
                                onAction="#onBattleGenSelect" userData="1"/>
                        <Button fx:id="battleGen2Btn" text="Gen 2" styleClass="option-btn"
                                onAction="#onBattleGenSelect" userData="2"/>
                        <Button fx:id="battleGen3Btn" text="Gen 3" styleClass="option-btn"
                                onAction="#onBattleGenSelect" userData="3"/>
                    </HBox>
                </VBox>
            </VBox>
            <StackPane styleClass="section-divider"><VBox.margin><Insets top="14" bottom="14"/></VBox.margin></StackPane>
            <VBox styleClass="settings-section" spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Show Move Animation" styleClass="section-label"/>
                    <StackPane fx:id="animationToggle" styleClass="toggle-switch,toggle-off"
                               onMouseClicked="#onAnimationToggle">
                        <StackPane fx:id="animationKnob" styleClass="toggle-knob"/>
                    </StackPane>
                </HBox>
            </VBox>

            <StackPane styleClass="section-divider"><VBox.margin><Insets top="14" bottom="14"/></VBox.margin></StackPane>
            <VBox styleClass="settings-section" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Language" styleClass="section-label"/>
                    <HBox spacing="0" styleClass="segmented-group">
                        <Button fx:id="langEnBtn" text="English" styleClass="seg-btn,seg-left,option-selected"
                                onAction="#onLanguageSelect" userData="en"/>
                        <Button fx:id="langJpBtn" text="日本語" styleClass="seg-btn,seg-right"
                                onAction="#onLanguageSelect" userData="jp"/>
                    </HBox>
                </HBox>
            </VBox>
            <Button fx:id="closeButton" text="Close"
                    onAction="#onCloseButtonClick"
                    prefWidth="110" styleClass="button-blue">
                <VBox.margin><Insets top="22"/></VBox.margin>
            </Button>
        </VBox>
        <Button fx:id="closeXButton" text="✕"
                onAction="#onCloseButtonClick"
                styleClass="close-x-button"
                StackPane.alignment="TOP_RIGHT"
                translateX="14" translateY="-14"/>

    </StackPane>
</StackPane>