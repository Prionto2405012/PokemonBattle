<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<VBox alignment="CENTER" minHeight="700" minWidth="1200" spacing="30.0" 
      styleClass="menu-container" 
      stylesheets="@../css/common.css,@../css/menu.css" 
      xmlns="http://javafx.com/javafx/25" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.example.pokemonbattle.controller.MenuController">
  <children>
    <StackPane fx:id="rootPane" VBox.vgrow="ALWAYS">
        <ImageView fx:id="bgImage"
                   preserveRatio="false"
                   pickOnBounds="true">
            <image>
                <Image url="@../assets/menu1.png"/>
            </image>
        </ImageView>
        <Region fx:id="menuOverlay" mouseTransparent="true" opacity="0" styleClass="menu-left-overlay" StackPane.alignment="CENTER_LEFT"/>
        <StackPane fx:id="selectBall" styleClass="pokeball" visible="false" mouseTransparent="true"/>
        <VBox fx:id="buttonContainer" alignment="CENTER_LEFT" spacing="10" StackPane.alignment="CENTER_LEFT">
            <padding><Insets left="80"/></padding>
            <Button fx:id="newGameButton" styleClass="menu-btn" text="New Game"/>
            <Button fx:id="loadGameButton" styleClass="menu-btn" text="Load Game"/>
            <Button fx:id="settingsButton" styleClass="menu-btn" text="Settings"/>
            <Button fx:id="backButton" styleClass="menu-btn" text="Go Back"/>
            <Button fx:id="exitButton" styleClass="menu-btn" text="Exit Game"/>
        </VBox>
    </StackPane>
  </children>
</VBox>
