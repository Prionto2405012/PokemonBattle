<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="overlayRoot"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.pokemonbattle.controller.AvatarSelectionController"
           styleClass="overlay-root"
           alignment="CENTER"
           stylesheets="@../css/common.css,@../css/avatar_selection.css"
           onMouseClicked="#onBackgroundClick">

    <!--
        FROSTED BACKDROP  fills the padded area.
        To change the screen-edge gap, edit .overlay-root padding in avatar_selection.css.
    -->
    <Region styleClass="overlay-backdrop" mouseTransparent="true"/>

    <!-- Content layer -->
    <VBox alignment="TOP_CENTER" spacing="10" styleClass="overlay-container"
          onMouseClicked="#onCardClick" maxWidth="860">
        <padding>
            <Insets top="24" bottom="24" left="40" right="40"/>
        </padding>

        <!-- Title -->
        <Label text="Choose Your Avatar" styleClass="overlay-title">
            <font><Font name="SPACE NOVA" size="28"/></font>
        </Label>

        <!-- Filter Buttons -->
        <HBox fx:id="filterBox" alignment="CENTER_RIGHT" spacing="8">
            <padding><Insets top="4" bottom="4"/></padding>
            <Button fx:id="filterAllBtn"    text="All"    styleClass="filter-btn,filter-active"
                    onAction="#onFilterAll"/>
            <Button fx:id="filterMaleBtn"   text="Male"   styleClass="filter-btn"
                    onAction="#onFilterMale"/>
            <Button fx:id="filterFemaleBtn" text="Female" styleClass="filter-btn"
                    onAction="#onFilterFemale"/>
        </HBox>

        <!-- 3D Carousel Area  VBox.vgrow fills available height -->
        <StackPane fx:id="carouselPane" prefHeight="420" minHeight="380"
                   VBox.vgrow="ALWAYS" styleClass="carousel-area">
            <!-- Avatar cards are built programmatically (3D ring) -->

            <!-- Navigation Arrows  use solid block triangles, rendered by system font -->
            <Button fx:id="leftArrowBtn"  text="&#x25C0;" styleClass="carousel-arrow"
                    onAction="#onCarouselLeft"  StackPane.alignment="CENTER_LEFT">
                <StackPane.margin><Insets left="12"/></StackPane.margin>
            </Button>
            <Button fx:id="rightArrowBtn" text="&#x25B6;" styleClass="carousel-arrow"
                    onAction="#onCarouselRight" StackPane.alignment="CENTER_RIGHT">
                <StackPane.margin><Insets right="12"/></StackPane.margin>
            </Button>
        </StackPane>

        <!-- Avatar name label -->
        <Label fx:id="avatarInfoLabel" text="" styleClass="avatar-info-label">
            <font><Font name="SPACE NOVA" size="16"/></font>
        </Label>

        <!-- Action Buttons (Cancel + Select, built programmatically) -->
        <HBox fx:id="actionButtonsBox" alignment="CENTER" spacing="50">
            <padding><Insets top="8" bottom="4"/></padding>
        </HBox>
    </VBox>
</StackPane>