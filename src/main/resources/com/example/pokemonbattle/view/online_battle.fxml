<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" minHeight="700" minWidth="1200"
    styleClass="battle-screen" stylesheets="@../css/common.css,@../css/battle.css"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.pokemonbattle.controller.OnlineBattleController">

    <!-- Background Image -->
    <ImageView fx:id="bgImage" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../assets/battle2.jpg" />
        </image>
    </ImageView>

    <!-- Main horizontal split: Battle (left) + Options (right) -->
    <HBox fx:id="mainBattleLayout" StackPane.alignment="CENTER" visible="false" managed="false">
        <!-- ============ BATTLE SECTION (left) ============ -->
        <StackPane fx:id="battleSection" styleClass="battle-section" HBox.hgrow="ALWAYS">
            <AnchorPane fx:id="battleField" styleClass="battle-field">

                <!-- Opponent info plate -->
                <VBox fx:id="opponentInfoPlate" styleClass="info-plate, opponent-plate"
                    AnchorPane.topAnchor="30" AnchorPane.leftAnchor="40" spacing="2">
                    <Label fx:id="opponentPokemonNameLabel" text="Pokemon"
                        styleClass="pokemon-name-label" />
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="HP" styleClass="hp-tag" />
                        <StackPane styleClass="hp-bar-track" prefWidth="180" prefHeight="8">
                            <Rectangle fx:id="opponentHpBar" styleClass="hp-bar-fill" width="180"
                                height="8" arcWidth="8" arcHeight="8"
                                StackPane.alignment="CENTER_LEFT" />
                        </StackPane>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label fx:id="opponentPokemonHpLabel" text="100 / 100"
                            styleClass="hp-text-label" />
                        <HBox fx:id="opponentTypesBox" spacing="4" alignment="CENTER_LEFT" />
                    </HBox>
                </VBox>

                <!-- Opponent sprite -->
                <ImageView fx:id="opponentSpriteImage" fitHeight="240" fitWidth="240"
                    pickOnBounds="true" preserveRatio="true"
                    AnchorPane.bottomAnchor="300" AnchorPane.rightAnchor="50" />

                <!-- Player sprite -->
                <ImageView fx:id="playerSpriteImage" fitHeight="260" fitWidth="260"
                    pickOnBounds="true" preserveRatio="true"
                    AnchorPane.bottomAnchor="120" AnchorPane.leftAnchor="50" />

                <!-- Player info plate -->
                <VBox fx:id="playerInfoPlate" styleClass="info-plate, player-plate"
                    AnchorPane.bottomAnchor="30" AnchorPane.rightAnchor="40" spacing="2">
                    <Label fx:id="playerPokemonNameLabel" text="Pokemon"
                        styleClass="pokemon-name-label" />
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="HP" styleClass="hp-tag" />
                        <StackPane styleClass="hp-bar-track" prefWidth="180" prefHeight="8">
                            <Rectangle fx:id="playerHpBar" styleClass="hp-bar-fill" width="180"
                                height="8" arcWidth="8" arcHeight="8"
                                StackPane.alignment="CENTER_LEFT" />
                        </StackPane>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label fx:id="playerPokemonHpLabel" text="100 / 100"
                            styleClass="hp-text-label" />
                        <HBox fx:id="playerTypesBox" spacing="4" alignment="CENTER_LEFT" />
                    </HBox>
                </VBox>

                <!-- Battle status label at the bottom -->
                <Label fx:id="battleStatusLabel" styleClass="battle-status-label"
                    text="Online Battle Starting..."
                    AnchorPane.bottomAnchor="5" AnchorPane.leftAnchor="20"
                    AnchorPane.rightAnchor="20" />

            </AnchorPane>
        </StackPane>

        <!-- ============ OPTIONS SECTION (right) ============ -->
        <StackPane fx:id="optionsSection" styleClass="options-section" maxWidth="420" minWidth="340">

            <Region styleClass="options-bg-pattern" />

            <VBox alignment="CENTER" spacing="16" styleClass="options-content">
                <padding>
                    <Insets top="24" bottom="24" left="20" right="20" />
                </padding>

                <!-- Hidden team labels (used internally) -->
                <VBox fx:id="playerPokemonBox" managed="false" visible="false" />
                <VBox fx:id="opponentPokemonBox" managed="false" visible="false" />
                <Label fx:id="playerNameLabel" managed="false" visible="false" />
                <Label fx:id="opponentNameLabel" managed="false" visible="false" />
                <Label fx:id="playerTeamLabel" managed="false" visible="false" />
                <Label fx:id="opponentTeamLabel" managed="false" visible="false" />

                <!-- ── Action panel (FIGHT / POKéMON / RUN) ── -->
                <VBox fx:id="actionButtonsBox" alignment="CENTER" spacing="20" managed="true"
                    visible="true">

                    <Button fx:id="attackButton" text="FIGHT" styleClass="fight-btn"
                        prefWidth="260" prefHeight="110">
                        <font>
                            <Font name="System Bold" size="28" />
                        </font>
                    </Button>

                    <HBox alignment="CENTER" spacing="14">
                        <!-- "Waiting" status label (replaces the START BATTLE button in online
                        mode) -->
                        <Label fx:id="waitingLabel" text="⏳ Waiting..."
                            style="-fx-font-size:13px; -fx-text-fill:#f8d030; -fx-font-weight:bold;"
                            managed="false" visible="false"
                            prefWidth="150" prefHeight="50" />
                        <Button fx:id="changePokemonMainButton" text="POKéMON"
                            styleClass="option-btn, option-btn-red"
                            prefWidth="150" prefHeight="50">
                            <font>
                                <Font size="13" />
                            </font>
                        </Button>
                    </HBox>

                    <HBox alignment="CENTER" spacing="14">
                        <Button fx:id="itemsButton" text="BAG"
                            styleClass="option-btn, option-btn-yellow"
                            prefWidth="150" prefHeight="50">
                            <font>
                                <Font size="13" />
                            </font>
                        </Button>
                        <Button fx:id="backButton" text="RUN"
                            styleClass="option-btn, option-btn-blue"
                            prefWidth="150" prefHeight="50">
                            <font>
                                <Font size="13" />
                            </font>
                        </Button>
                    </HBox>
                </VBox>

                <!-- ── Move selection panel ── -->
                <VBox fx:id="moveSelectionBox" alignment="CENTER" spacing="8"
                    managed="false" visible="false" styleClass="move-selection-box">
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10" />
                    </padding>
                    <VBox fx:id="moveButtonsContainer" alignment="CENTER" spacing="7" maxWidth="310" />
                    <Button text="← Back" styleClass="move-back-btn" onAction="#onBackToActions"
                        prefWidth="120" prefHeight="36">
                        <font>
                            <Font size="12" />
                        </font>
                    </Button>
                </VBox>

                <!-- ── Pokemon selection panel ── -->
                <VBox fx:id="pokemonSelectionBox" alignment="CENTER" spacing="10"
                    managed="false" visible="false" styleClass="pokemon-selection-box">
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10" />
                    </padding>
                    <Label text="Choose Pokémon:" styleClass="section-header-label" />
                    <VBox fx:id="pokemonButtonsBox" alignment="CENTER" spacing="8" />
                    <Button text="← Back" styleClass="move-back-btn" onAction="#onBackToActions"
                        prefWidth="120" prefHeight="36">
                        <font>
                            <Font size="12" />
                        </font>
                    </Button>
                </VBox>

            </VBox>
        </StackPane>
    </HBox>

    <!-- VS INTRO SCREEN -->
    <AnchorPane fx:id="vsScreenPane">
        <ImageView fx:id="vsBgImage" pickOnBounds="true" preserveRatio="false"
            AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0">
            <image>
                <Image url="@../assets/fight.png" />
            </image>
        </ImageView>
        <!-- Player trainer sprite — bottom half, slides in from left -->
        <ImageView fx:id="vsPlayerSprite"
            fitWidth="450" fitHeight="420"
            preserveRatio="true" smooth="true"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0" />
        <!-- Opponent trainer sprite — top half, slides in from right -->
        <ImageView fx:id="vsOpponentSprite"
            fitWidth="450" fitHeight="420"
            preserveRatio="true" smooth="true"
            AnchorPane.topAnchor="-20"
            AnchorPane.rightAnchor="0" />
    </AnchorPane>

    <!-- BATTLE RESULT OVERLAY — shown after battle ends -->
    <StackPane fx:id="battleResultOverlay" visible="false" managed="false"
        style="-fx-background-color: rgba(0,0,0,0.60);">
        <VBox fx:id="battleResultCard" alignment="CENTER" spacing="20"
            maxWidth="560" maxHeight="300" styleClass="result-card">
            <Label fx:id="resultTitleLabel" styleClass="result-title" text="Victory!" />
            <Label fx:id="resultMessageLabel" styleClass="result-message"
                text="Congratulations! You won!"
                wrapText="true" textAlignment="CENTER" maxWidth="460" />
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="goBackResultButton" text="Back to Menu"
                    prefWidth="220" prefHeight="50" onAction="#onGoBackClicked"
                    styleClass="result-btn, result-btn-back" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- FORFEIT CONFIRMATION OVERLAY -->
    <StackPane fx:id="forfeitOverlay" visible="false" managed="false"
        mouseTransparent="false" StackPane.alignment="CENTER">
        <Region fx:id="forfeitBackdrop" styleClass="exit-backdrop" mouseTransparent="false" />
        <VBox fx:id="forfeitDialog" styleClass="exit-dialog"
            alignment="CENTER" spacing="24"
            maxWidth="420" maxHeight="240" StackPane.alignment="CENTER">
            <padding>
                <Insets top="36" bottom="32" left="36" right="36" />
            </padding>
            <Label text="Forfeit Battle?" styleClass="exit-dialog-title" />
            <Label
                text="Are you sure you want to forfeit? Your opponent will be declared the winner."
                styleClass="exit-dialog-body" wrapText="true" textAlignment="CENTER" maxWidth="340" />
            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="forfeitYesButton" text="Yes, Forfeit"
                    styleClass="exit-btn-yes" onAction="#onForfeitConfirmed" />
                <Button fx:id="forfeitNoButton" text="Cancel"
                    styleClass="exit-btn-no" onAction="#onForfeitCancelled" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- BLACK FADE OVERLAY — covers everything during VS→Battle transition -->
    <Region fx:id="rootBlackFade"
        style="-fx-background-color: black;"
        opacity="0"
        mouseTransparent="true" />
</StackPane>