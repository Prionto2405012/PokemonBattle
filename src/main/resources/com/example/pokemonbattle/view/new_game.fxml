<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="670" minWidth="1150" spacing="20.0"
    styleClass="battle-setup-screen" stylesheets="@../css/style.css"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.pokemonbattle.controller.NewGameController">

    <children>

        <StackPane fx:id="rootPane" VBox.vgrow="ALWAYS">

            <!-- Background Image -->
            <ImageView fx:id="bgImage" pickOnBounds="true" preserveRatio="false">
                <image>
                    <Image url="@../assets/new_game.png" />
                </image>
            </ImageView>

            <!-- Centered fixed-size layout -->
            <StackPane alignment="CENTER">

                <VBox fx:id="contentVBox" alignment="TOP_CENTER" maxHeight="650" maxWidth="1000"
                    prefHeight="650.0" prefWidth="1000.0" spacing="15">
                    <padding>
                        <Insets top="10" bottom="10" left="20" right="20" />
                    </padding>

                    <!-- Title -->
                    <Label styleClass="title-label" text="Battle Setup">
                        <font>
                            <Font name="System Bold" size="22" />
                        </font>
                    </Label>

                    <!-- Game Mode Selection -->
                    <VBox alignment="CENTER" spacing="8"
                        style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding>
                            <Insets bottom="10" left="15" right="15" top="10" />
                        </padding>

                        <Label styleClass="section-label" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #06847c;" text="Select Game Mode" />

                        <HBox fx:id="modeSelectionBox" alignment="CENTER" spacing="20">
                            <ToggleButton fx:id="soloModeButton" prefHeight="32" prefWidth="160"
                                styleClass="button-blue" text="SOLO" />
                            <ToggleButton fx:id="duoModeButton" prefHeight="32" prefWidth="160"
                                styleClass="button-purple" text="DUO" />
                        </HBox>
                    </VBox>

                    <!-- Opponent Selection -->
                    <VBox alignment="CENTER" spacing="8"
                        style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding>
                            <Insets bottom="10" left="15" right="15" top="10" />
                        </padding>

                        <Label styleClass="section-label" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #06847c;" text="Choose Opponent" />

                        <HBox fx:id="opponentSelectionBox" alignment="CENTER" spacing="20">
                            <ToggleButton fx:id="aiOpponentButton" prefHeight="32" prefWidth="180"
                                styleClass="button-green" text="AI Opponent" />
                            <ToggleButton fx:id="localOpponentButton" prefHeight="32"
                                prefWidth="180"
                                styleClass="button-orange" text="Local Player" />
                        </HBox>
                        <Label fx:id="matchingStatusLabel"
                            style="-fx-font-size:12px; -fx-text-fill:#ffffff; -fx-font-style:italic;"
                            text="Select opponent type" />
                    </VBox>

                    <!-- Team Selection -->
                    <VBox alignment="CENTER" spacing="8"
                        style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding>
                            <Insets bottom="10" left="15" right="15" top="10" />
                        </padding>

                        <Label styleClass="section-label" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #06847c;" text="Team Selection" />

                        <HBox fx:id="teamSelectionBox" alignment="CENTER" spacing="20">
                            <ToggleButton fx:id="randomTeamButton" prefHeight="32" prefWidth="160"
                                styleClass="button-red" text="RANDOM" />
                            <Button fx:id="editTeamButton" prefHeight="32" prefWidth="160"
                                styleClass="button-blue" text="Edit Team" visible="false" managed="false" />
                            <ToggleButton fx:id="customTeamButton" prefHeight="32" prefWidth="160"
                                styleClass="button-purple" text="CUSTOM" />
                        </HBox>

                        <Label fx:id="teamCountLabel"
                            style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#78C850;"
                            text="Team: 0/6" />
                    </VBox>

                    <!-- Pokemon Selection Grid (for Custom Team) -->
                    <HBox spacing="15" VBox.vgrow="ALWAYS">
                        <!-- Pokemon Grid ScrollPane -->
                        <ScrollPane fx:id="pokemonScrollPane" managed="false" visible="false"
                            fitToWidth="true" prefHeight="280" prefWidth="600"
                            style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10;">
                            <content>
                                <GridPane fx:id="pokemonGrid" hgap="12" vgap="12">
                                    <padding>
                                        <Insets top="10" bottom="10" left="10" right="10" />
                                    </padding>
                                </GridPane>
                            </content>
                        </ScrollPane>

                        <!-- Selected Team Preview -->
                        <VBox fx:id="selectedTeamBox" managed="false" visible="false"
                            spacing="8" prefWidth="350" prefHeight="280"
                            style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10;">
                            <padding>
                                <Insets top="10" bottom="10" left="10" right="10" />
                            </padding>
                        </VBox>
                    </HBox>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER" spacing="25">
                        <padding>
                            <Insets top="5" />
                        </padding>
                        <Button fx:id="backButton" prefHeight="35" prefWidth="150"
                            styleClass="button-gray" text="Back">
                            <font>
                                <Font size="16" />
                            </font>
                        </Button>
                        <Button fx:id="startBattleButton" prefHeight="35" prefWidth="150"
                            styleClass="button-green" text="START">
                            <font>
                                <Font size="16" />
                            </font>
                        </Button>
                    </HBox>

                </VBox>

            </StackPane>

        </StackPane>

    </children>
</VBox>