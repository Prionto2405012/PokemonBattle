<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="670" minWidth="1150" spacing="30.0" styleClass="battle-setup-screen" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pokemonbattle.controller.NewGameController">

    <children>

        <StackPane fx:id="rootPane" VBox.vgrow="ALWAYS">

            <!-- Background Image -->
            <ImageView fx:id="bgImage" pickOnBounds="true" preserveRatio="false">
                <image>
                    <Image url="@../assets/new_game.png" />
                </image>
            </ImageView>

            <!-- Centered fixed-size layout -->
            <StackPane alignment="CENTER">

                <VBox fx:id="contentVBox" alignment="TOP_CENTER" maxHeight="600" maxWidth="980" prefHeight="561.0" prefWidth="925.0" spacing="12">

                    <!-- Title -->
                    <Label styleClass="title-label" text="Battle Setup">
                        <font>
                            <Font name="System Bold" size="20" />
                        </font>
                    </Label>

                    <!-- Game Mode Selection -->
                    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding>
                            <Insets bottom="8" left="15" right="15" top="8" />
                        </padding>

                        <Label styleClass="menu-label" text="Select Game Mode" />

                        <HBox fx:id="modeSelectionBox" alignment="CENTER" spacing="20">
                            <ToggleButton fx:id="soloModeButton" prefHeight="30" prefWidth="160" styleClass="button-blue" text="SOLO" />
                            <ToggleButton fx:id="duoModeButton" prefHeight="30" prefWidth="160" styleClass="button-purple" text="DUO" />
                        </HBox>
                    </VBox>

                    <!-- Opponent Selection -->
                    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding>
                            <Insets bottom="8" left="15" right="15" top="8" />
                        </padding>

                        <Label styleClass="menu-label" text="Choose Opponent" />

                        <HBox fx:id="opponentSelectionBox" alignment="CENTER" spacing="20">
                            <ToggleButton fx:id="aiOpponentButton" prefHeight="30" prefWidth="180" styleClass="button-green" text="AI Opponent" />
                            <ToggleButton fx:id="localOpponentButton" prefHeight="30" prefWidth="180" styleClass="button-orange" text="Local Player" />
                        </HBox>

                        <Label fx:id="matchingStatusLabel" style="-fx-font-size:12px; -fx-text-fill:#ffffff; -fx-font-style:italic;" text="Select opponent type" />
                    </VBox>

                    <!-- Team Selection -->
                    <VBox alignment="CENTER" prefHeight="125.0" prefWidth="980.0" spacing="8" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding>
                            <Insets bottom="8" left="15" right="15" top="8" />
                        </padding>

                        <Label prefHeight="0.0" prefWidth="258.0" styleClass="menu-label" text="Team Selection" />

                        <HBox fx:id="teamSelectionBox" alignment="CENTER" prefHeight="54.0" prefWidth="694.0" spacing="20">
                            <ToggleButton fx:id="randomTeamButton" prefHeight="30" prefWidth="160" styleClass="button-red" text="RANDOM" />
                            <ToggleButton fx:id="customTeamButton" prefHeight="30" prefWidth="160" styleClass="button-purple" text="CUSTOM" />
                        </HBox>

                        <Label fx:id="teamCountLabel" style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#ffffff;" text="Team: 0/6" />
                    </VBox>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER" prefHeight="0.0" prefWidth="900.0" spacing="25">
                        <Button fx:id="backButton" prefHeight="20" prefWidth="140" styleClass="button-gray" text="Back" />
                        <Button fx:id="startBattleButton" prefHeight="20" prefWidth="140" styleClass="button-green" text="START" />
                    </HBox>

                </VBox>

            </StackPane>

        </StackPane>

    </children>
</VBox>
