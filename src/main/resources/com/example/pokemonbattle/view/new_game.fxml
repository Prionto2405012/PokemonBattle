<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="670" minWidth="1150" spacing="0"
    styleClass="battle-setup-screen"
    stylesheets="@../css/common.css,@../css/new_game.css"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.pokemonbattle.controller.NewGameController">

    <children>

        <StackPane fx:id="rootPane" VBox.vgrow="ALWAYS">

            <!-- Background Image -->
            <ImageView fx:id="bgImage" pickOnBounds="true" preserveRatio="false">
                <image>
                    <Image url="@../assets/new_game.png" />
                </image>
            </ImageView>

            <!-- Dark focus overlay -->
            <Region fx:id="dashboardOverlay" styleClass="dashboard-dark-overlay"
                    mouseTransparent="true"/>

            <!-- ═══ Main Dashboard HBox ═══ -->
            <HBox alignment="CENTER" spacing="25" maxWidth="1100" maxHeight="650">
                <padding>
                    <Insets top="15" bottom="15" left="25" right="25"/>
                </padding>

                <!-- ═══ LEFT PANEL: Avatar + Stats ═══ -->
                <VBox fx:id="avatarPanel" alignment="CENTER" spacing="12"
                      prefWidth="270" minWidth="250" styleClass="avatar-panel">
                    <padding>
                        <Insets top="20" bottom="20" left="15" right="15"/>
                    </padding>

                    <!-- Avatar Display -->
                    <StackPane styleClass="avatar-display-frame" prefWidth="200" prefHeight="200">
                        <ImageView fx:id="avatarDisplay" fitWidth="180" fitHeight="180"
                                   preserveRatio="true" smooth="true"/>
                    </StackPane>

                    <!-- Player Name -->
                    <Label fx:id="playerNameLabel" text="Trainer"
                           styleClass="player-name-label">
                        <font><Font name="System Bold" size="20"/></font>
                    </Label>

                    <!-- Win/Loss Stats -->
                    <HBox alignment="CENTER" spacing="20">
                        <VBox alignment="CENTER" spacing="2" styleClass="stat-box">
                            <Label text="WINS" styleClass="stat-label"/>
                            <Label fx:id="winsLabel" text="0" styleClass="stat-value-win"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="stat-box">
                            <Label text="LOSSES" styleClass="stat-label"/>
                            <Label fx:id="lossesLabel" text="0" styleClass="stat-value-loss"/>
                        </VBox>
                    </HBox>

                    <!-- Battle History Button -->
                    <Button fx:id="battleHistoryButton" text="Battle History"
                            styleClass="button-blue" prefWidth="200" prefHeight="36"
                            onAction="#onBattleHistoryClick">
                        <font><Font size="14"/></font>
                        <VBox.margin><Insets top="8"/></VBox.margin>
                    </Button>

                    <!-- Change Avatar Button -->
                    <Button fx:id="changeAvatarButton" text="Change Avatar"
                            styleClass="button-gray" prefWidth="200" prefHeight="32"
                            onAction="#onChangeAvatarClick">
                        <font><Font size="12"/></font>
                    </Button>
                </VBox>

                <!-- ═══ RIGHT PANEL: Battle Setup ═══ -->
                <VBox fx:id="contentVBox" alignment="TOP_CENTER" spacing="12"
                      HBox.hgrow="ALWAYS" maxWidth="750"
                      prefHeight="620">
                    <padding>
                        <Insets top="10" bottom="10" left="15" right="15"/>
                    </padding>

                    <!-- Title -->
                    <Label styleClass="title-label" text="Battle Setup">
                        <font><Font name="System Bold" size="20"/></font>
                    </Label>

                    <!-- Game Mode Selection -->
                    <VBox alignment="CENTER" spacing="6" styleClass="setup-section">
                        <padding>
                            <Insets bottom="8" left="15" right="15" top="8"/>
                        </padding>
                        <Label styleClass="section-label"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #06847c;"
                               text="Select Game Mode"/>
                        <HBox fx:id="modeSelectionBox" alignment="CENTER" spacing="20">
                            <ToggleButton fx:id="soloModeButton" prefHeight="30" prefWidth="150"
                                          styleClass="button-blue" text="SOLO"/>
                            <ToggleButton fx:id="duoModeButton" prefHeight="30" prefWidth="150"
                                          styleClass="button-purple" text="DUO"/>
                        </HBox>
                    </VBox>

                    <!-- Opponent Selection -->
                    <VBox alignment="CENTER" spacing="6" styleClass="setup-section">
                        <padding>
                            <Insets bottom="8" left="15" right="15" top="8"/>
                        </padding>
                        <Label styleClass="section-label"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #06847c;"
                               text="Choose Opponent"/>
                        <HBox fx:id="opponentSelectionBox" alignment="CENTER" spacing="20">
                            <ToggleButton fx:id="aiOpponentButton" prefHeight="30" prefWidth="170"
                                          styleClass="button-green" text="AI Opponent"/>
                            <ToggleButton fx:id="localOpponentButton" prefHeight="30" prefWidth="170"
                                          styleClass="button-orange" text="Local Player"/>
                            <ToggleButton fx:id="onlineOpponentButton" prefHeight="30" prefWidth="170"
                                          styleClass="button-purple" text="Online Player"/>
                        </HBox>
                        <Label fx:id="matchingStatusLabel"
                               style="-fx-font-size:12px; -fx-text-fill:#ffffff; -fx-font-style:italic;"
                               text="Select opponent type"/>
                    </VBox>

                    <!-- Team Selection -->
                    <VBox alignment="CENTER" spacing="6" styleClass="setup-section">
                        <padding>
                            <Insets bottom="8" left="15" right="15" top="8"/>
                        </padding>
                        <Label styleClass="section-label"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #06847c;"
                               text="Team Selection"/>
                        <HBox fx:id="teamSelectionBox" alignment="CENTER" spacing="15">
                            <ToggleButton fx:id="randomTeamButton" prefHeight="30" prefWidth="150"
                                          styleClass="button-red" text="RANDOM"/>
                            <Button fx:id="editTeamButton" prefHeight="30" prefWidth="150"
                                    styleClass="button-blue" text="Edit Team"
                                    visible="false" managed="false"/>
                            <ToggleButton fx:id="customTeamButton" prefHeight="30" prefWidth="150"
                                          styleClass="button-purple" text="CUSTOM"/>
                        </HBox>
                        <Label fx:id="teamCountLabel"
                               style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#78C850;"
                               text="Team: 0/6"/>
                    </VBox>

                    <!-- Hidden Pokemon Grid (used by overlay, kept for compatibility) -->
                    <HBox spacing="15" VBox.vgrow="ALWAYS" managed="false" visible="false">
                        <ScrollPane fx:id="pokemonScrollPane" managed="false" visible="false"
                                    fitToWidth="true" prefHeight="250" prefWidth="550">
                            <content>
                                <GridPane fx:id="pokemonGrid" hgap="12" vgap="12">
                                    <padding>
                                        <Insets top="10" bottom="10" left="10" right="10"/>
                                    </padding>
                                </GridPane>
                            </content>
                        </ScrollPane>
                        <VBox fx:id="selectedTeamBox" managed="false" visible="false"
                              spacing="8" prefWidth="320" prefHeight="250"/>
                    </HBox>

                    <!-- View Selected Pokémon Button (appears dynamically) -->
                    <Button fx:id="viewSelectedPokemonButton" text="View Selected Pokémon"
                            styleClass="button-purple" prefWidth="240" prefHeight="34"
                            visible="false" managed="false"
                            onAction="#onViewSelectedPokemonClick">
                        <font><Font size="14"/></font>
                    </Button>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER" spacing="25">
                        <padding><Insets top="6"/></padding>
                        <Button fx:id="backButton" prefHeight="34" prefWidth="140"
                                styleClass="button-gray" text="Back">
                            <font><Font size="15"/></font>
                        </Button>
                        <Button fx:id="startBattleButton" prefHeight="34" prefWidth="140"
                                styleClass="button-green" text="START">
                            <font><Font size="15"/></font>
                        </Button>
                    </HBox>
                </VBox>
            </HBox>
        </StackPane>
    </children>
</VBox>