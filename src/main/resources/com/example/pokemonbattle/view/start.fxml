<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="rootPane"
           fx:controller="com.example.pokemonbattle.controller.StartController"
           xmlns:fx="http://javafx.com/fxml"
           prefWidth="1200" prefHeight="700"
           style="-fx-background-color: black;"
           stylesheets="@../css/common.css,@../css/start.css">
    <MediaView fx:id="bgVideo" mouseTransparent="true"
               fitWidth="1200" fitHeight="700"
               preserveRatio="false"/>
    <ImageView fx:id="fallbackImage"
               fitWidth="1200" fitHeight="700"
               preserveRatio="false"
               visible="false"
               mouseTransparent="true"/>
    <Region fx:id="vignetteOverlay" mouseTransparent="true"
            prefWidth="1200" prefHeight="700"
            styleClass="start-vignette"/>
    <VBox alignment="TOP_CENTER" prefWidth="1200" prefHeight="700" mouseTransparent="false">
        <Region VBox.vgrow="ALWAYS"/>
        <VBox alignment="CENTER" spacing="12" prefHeight="175" VBox.vgrow="NEVER" styleClass="start-button-section">
            <Button text="START"
                    onAction="#onStartButtonClick"
                    prefWidth="220"
                    prefHeight="56"
                    styleClass="start-btn"/>
        </VBox>

    </VBox>

</StackPane>
