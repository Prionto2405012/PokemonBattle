<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="overlayRoot" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.pokemonbattle.controller.PokemonSelectionOverlayController"
    style="-fx-background-color: rgba(0, 0, 0, 0.5);" alignment="CENTER"
    onMouseClicked="#onBackgroundClick">

    <!-- Glassmorphism Container -->
    <VBox alignment="TOP_CENTER" spacing="15" maxWidth="960" maxHeight="600" 
        style="-fx-background-color: rgba(255, 255, 255, 0.15); 
               -fx-background-radius: 20; 
               -fx-border-color: rgba(255, 255, 255, 0.3); 
               -fx-border-width: 2; 
               -fx-border-radius: 20;
               -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.4), 25, 0, 0, 5);
               -fx-backdrop-filter: blur(10px);">
        <padding>
            <Insets top="20" bottom="20" left="25" right="25" />
        </padding>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="Select Your Team" styleClass="title-label"
                style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ffffff; 
                       -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 8, 0, 0, 2);">
                <font>
                    <Font name="System Bold" size="28" />
                </font>
            </Label>
            <Label fx:id="selectionCountLabel" text="Selected: 0 / 6"
                style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #78C850;
                       -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 5, 0, 0, 1);">
                <font>
                    <Font size="16" />
                </font>
            </Label>
        </VBox>

        <!-- Main Content Area -->
        <HBox spacing="15" VBox.vgrow="ALWAYS">
            <!-- Pokemon Grid ScrollPane -->
            <ScrollPane fx:id="pokemonScrollPane" fitToWidth="true" 
                prefWidth="600" prefHeight="440"
                style="-fx-background: rgba(0, 0, 0, 0.2); 
                       -fx-background-color: transparent;
                       -fx-border-color: rgba(255, 255, 255, 0.2); 
                       -fx-border-width: 1; 
                       -fx-border-radius: 12;">
                <content>
                    <GridPane fx:id="pokemonGrid" hgap="10" vgap="10">
                        <padding>
                            <Insets top="10" bottom="10" left="10" right="10" />
                        </padding>
                    </GridPane>
                </content>
            </ScrollPane>

            <!--Stats Panel -->
            <VBox fx:id="statsPanel" spacing="10" prefWidth="310" prefHeight="440"
                style="-fx-background-color: rgba(0, 0, 0, 0.3); 
                       -fx-background-radius: 12; 
                       -fx-border-color: rgba(255, 255, 255, 0.25); 
                       -fx-border-width: 1.5; 
                       -fx-border-radius: 12;
                       -fx-padding: 15;">
                
                <!-- Pokemon Name -->
                <Label fx:id="statsPokemonName" text="Hover over a Pokémon" 
                    style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ffffff;
                           -fx-wrap-text: true;">
                    <font>
                        <Font name="System Bold" size="20" />
                    </font>
                </Label>

                <!-- Pokemon Sprite -->
                <StackPane prefHeight="100" alignment="CENTER">
                    <VBox fx:id="statsSpriteContainer" alignment="CENTER" />
                </StackPane>

                <!-- Types -->
                <HBox fx:id="statsTypesBox" spacing="8" alignment="CENTER" />

                <!-- Stats Details -->
                <VBox fx:id="statsDetailsBox" spacing="8" 
                    style="-fx-background-color: rgba(255, 255, 255, 0.1); 
                           -fx-background-radius: 8; 
                           -fx-padding: 10;">
                    <Label text="Stats:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f8d030;" />
                </VBox>

                <!-- Moves -->
                <VBox fx:id="statsMovesBox" spacing="6"
                    style="-fx-background-color: rgba(255, 255, 255, 0.1); 
                           -fx-background-radius: 8; 
                           -fx-padding: 10;">
                    <Label text="Moves:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6890F0;" />
                </VBox>
            </VBox>
        </HBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="clearButton" text="Clear Selection" 
                prefHeight="38" prefWidth="160"
                styleClass="button-dark"
                onAction="#onClearSelection">
                <font>
                    <Font size="15" />
                </font>
            </Button>
            
            <Button fx:id="doneButton" text="Done" 
                prefHeight="38" prefWidth="160"
                styleClass="button-green"
                onAction="#onDone">
                <font>
                    <Font size="15" />
                </font>
            </Button>
        </HBox>
    </VBox>

</StackPane>
