<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="700" minWidth="1200" spacing="20.0"
    styleClass="battle-screen" stylesheets="@../css/common.css,@../css/battle.css"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.pokemonbattle.controller.BattleController">

    <children>

        <StackPane fx:id="rootPane" VBox.vgrow="ALWAYS">

            <!-- Background Image -->
            <ImageView fx:id="bgImage" pickOnBounds="true" preserveRatio="false">
                <image>
                    <Image url="@../assets/new_game.png" />
                </image>
            </ImageView>

            <!-- Battle Layout -->
            <VBox alignment="CENTER" spacing="15" StackPane.alignment="CENTER">
                <padding>
                    <Insets top="10" bottom="10" left="40" right="40" />
                </padding>

                <!-- Title -->
                <Label fx:id="battleTitleLabel" styleClass="title-label" text="Battle Arena">
                    <font>
                        <Font name="System Bold" size="28" />
                    </font>
                </Label>

                <!-- Team Info Section (Hidden but needed for binding) -->
                <HBox alignment="CENTER" spacing="100" prefHeight="60" style="-fx-background-color: transparent;">
                    <!-- Player Team Info -->
                    <VBox alignment="CENTER" spacing="10" prefWidth="350"
                        style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 10;">
                        
                        <Label fx:id="playerNameLabel" text="Player" styleClass="menu-label"
                            style="-fx-font-size: 16px; -fx-text-fill: #78C850;">
                            <font>
                                <Font name="System Bold" size="16" />
                            </font>
                        </Label>
                        
                        <Label fx:id="playerTeamLabel" text="Team: Loading..." 
                            style="-fx-font-size: 11px; -fx-text-fill: #ffffff; -fx-wrap-text: true;" />
                        
                        <VBox fx:id="playerPokemonBox" spacing="4" alignment="CENTER">
                            <padding>
                                <Insets top="5" />
                            </padding>
                        </VBox>
                    </VBox>

                    <!-- Opponent Team Info -->
                    <VBox alignment="CENTER" spacing="10" prefWidth="350"
                        style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 10;">
                        
                        <Label fx:id="opponentNameLabel" text="Opponent" styleClass="menu-label"
                            style="-fx-font-size: 16px; -fx-text-fill: #F08030;">
                            <font>
                                <Font name="System Bold" size="16" />
                            </font>
                        </Label>
                        
                        <Label fx:id="opponentTeamLabel" text="Team: Loading..." 
                            style="-fx-font-size: 11px; -fx-text-fill: #ffffff; -fx-wrap-text: true;" />
                        
                        <VBox fx:id="opponentPokemonBox" spacing="4" alignment="CENTER">
                            <padding>
                                <Insets top="5" />
                            </padding>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Sprites and Names Section -->
                <HBox alignment="CENTER" spacing="80" prefHeight="200">
                    <!-- Player Pokemon -->
                    <VBox alignment="BOTTOM_CENTER" spacing="10">
                        <ImageView fx:id="playerSpriteImage" fitHeight="160" fitWidth="160" pickOnBounds="true" preserveRatio="true" />
                        <Label fx:id="playerPokemonNameLabel" text="Pokemon Name" 
                            style="-fx-font-size: 16px; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
                        <Label fx:id="playerPokemonHpLabel" text="HP: 100/100"
                            style="-fx-font-size: 13px; -fx-text-fill: #78C850;" />
                    </VBox>

                    <!-- Opponent Pokemon -->
                    <VBox alignment="TOP_CENTER" spacing="10">
                        <ImageView fx:id="opponentSpriteImage" fitHeight="160" fitWidth="160" pickOnBounds="true" preserveRatio="true" />
                        <Label fx:id="opponentPokemonNameLabel" text="Pokemon Name" 
                            style="-fx-font-size: 16px; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
                        <Label fx:id="opponentPokemonHpLabel" text="HP: 100/100"
                            style="-fx-font-size: 13px; -fx-text-fill: #78C850;" />
                    </VBox>
                </HBox>

                <!-- Status Label -->
                <Label fx:id="battleStatusLabel" text="Battle will begin shortly..."
                    style="-fx-font-size: 16px; -fx-text-fill: #f8d030; -fx-font-weight: bold; -fx-font-style: italic;" />

                <!-- Main Action Buttons: Attack, Change Pokemon -->
                <HBox alignment="CENTER" spacing="20" fx:id="actionButtonsBox" managed="false" visible="false">
                    <Button fx:id="attackButton" prefHeight="50" prefWidth="200" styleClass="button-blue" text="Attack">
                        <font><Font size="14" /></font>
                    </Button>
                    <Button fx:id="changePokemonMainButton" prefHeight="50" prefWidth="200" styleClass="button-purple" text="Change Pokemon">
                        <font><Font size="14" /></font>
                    </Button>
                </HBox>

                <!-- Move Selection Buttons (Hidden until Attack is clicked) -->
                <VBox spacing="10" fx:id="moveSelectionBox" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 15; -fx-background-radius: 10;" managed="false" visible="false">
                    <Label text="Select Move:" style="-fx-font-size: 14px; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="moveButton1" prefHeight="50" prefWidth="150" styleClass="button-blue" text="Move 1">
                            <font><Font size="12" /></font>
                        </Button>
                        <Button fx:id="moveButton2" prefHeight="50" prefWidth="150" styleClass="button-blue" text="Move 2">
                            <font><Font size="12" /></font>
                        </Button>
                        <Button fx:id="moveButton3" prefHeight="50" prefWidth="150" styleClass="button-blue" text="Move 3">
                            <font><Font size="12" /></font>
                        </Button>
                        <Button fx:id="moveButton4" prefHeight="50" prefWidth="150" styleClass="button-blue" text="Move 4">
                            <font><Font size="12" /></font>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Pokemon Selection Buttons (Hidden until Change Pokemon is clicked) -->
                <VBox spacing="10" fx:id="pokemonSelectionBox" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 15; -fx-background-radius: 10;" managed="false" visible="false">
                    <Label text="Select Pokemon:" style="-fx-font-size: 14px; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
                    <HBox alignment="CENTER" spacing="10" fx:id="pokemonButtonsBox">
                    </HBox>
                </VBox>

                <!-- Start/Back Buttons -->
                <HBox alignment="CENTER" spacing="30">
                    <Button fx:id="startBattleButton" prefHeight="40" prefWidth="180"
                        styleClass="button-green" text="START BATTLE">
                        <font>
                            <Font size="16" />
                        </font>
                    </Button>
                    
                    <Button fx:id="backButton" prefHeight="40" prefWidth="180"
                        styleClass="button-gray" text="Back to Setup">
                        <font>
                            <Font size="16" />
                        </font>
                    </Button>
                </HBox>

            </VBox>

        </StackPane>

    </children>
</VBox>
