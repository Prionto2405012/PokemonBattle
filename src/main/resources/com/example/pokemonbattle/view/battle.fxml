<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" minHeight="700" minWidth="1200"
    styleClass="battle-screen" stylesheets="@../css/common.css,@../css/battle.css"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.pokemonbattle.controller.BattleController">

    <!-- Background Image -->
    <ImageView fx:id="bgImage" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../assets/battle2.jpg" />
        </image>
    </ImageView>

    <!-- Main horizontal split: Battle (left) + Options (right) -->
    <HBox fx:id="mainBattleLayout" StackPane.alignment="CENTER" visible="false" managed="false">
        <!-- ============ BATTLE SECTION (left, larger) ============ -->
        <StackPane fx:id="battleSection" styleClass="battle-section" HBox.hgrow="ALWAYS">
            <AnchorPane fx:id="battleField" styleClass="battle-field">

                <!-- Opponent info plate (top-right-ish area of battle field) -->
                <VBox fx:id="opponentInfoPlate" styleClass="info-plate, opponent-plate"
                    AnchorPane.topAnchor="30" AnchorPane.leftAnchor="40" spacing="2">
                    <Label fx:id="opponentPokemonNameLabel" text="Pokemon"
                        styleClass="pokemon-name-label" />
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="HP" styleClass="hp-tag" />
                        <StackPane styleClass="hp-bar-track" prefWidth="180" prefHeight="8">
                            <Rectangle fx:id="opponentHpBar" styleClass="hp-bar-fill" width="180"
                                height="8" arcWidth="8" arcHeight="8"
                                StackPane.alignment="CENTER_LEFT" />
                        </StackPane>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label fx:id="opponentPokemonHpLabel" text="100 / 100"
                            styleClass="hp-text-label" />
                        <HBox fx:id="opponentTypesBox" spacing="4" alignment="CENTER_LEFT" />
                    </HBox>
                </VBox>

                <!-- Opponent sprite (positioned right-center) -->
                <ImageView fx:id="opponentSpriteImage" fitHeight="240" fitWidth="240"
                    pickOnBounds="true" preserveRatio="true"
                    AnchorPane.bottomAnchor="300" AnchorPane.rightAnchor="50" />

                <!-- Player sprite (positioned lower-left) -->
                <ImageView fx:id="playerSpriteImage" fitHeight="260" fitWidth="260"
                    pickOnBounds="true" preserveRatio="true"
                    AnchorPane.bottomAnchor="120" AnchorPane.leftAnchor="50" />

                <!-- Player info plate (bottom-right of battle field) -->
                <VBox fx:id="playerInfoPlate" styleClass="info-plate, player-plate"
                    AnchorPane.bottomAnchor="30" AnchorPane.rightAnchor="40" spacing="2">
                    <Label fx:id="playerPokemonNameLabel" text="Pokemon"
                        styleClass="pokemon-name-label" />
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="HP" styleClass="hp-tag" />
                        <StackPane styleClass="hp-bar-track" prefWidth="180" prefHeight="8">
                            <Rectangle fx:id="playerHpBar" styleClass="hp-bar-fill" width="180"
                                height="8" arcWidth="8" arcHeight="8"
                                StackPane.alignment="CENTER_LEFT" />
                        </StackPane>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label fx:id="playerPokemonHpLabel" text="100 / 100"
                            styleClass="hp-text-label" />
                        <HBox fx:id="playerTypesBox" spacing="4" alignment="CENTER_LEFT" />
                    </HBox>
                </VBox>

                <!-- Status text overlay at bottom center -->
                <Label fx:id="battleStatusLabel" styleClass="battle-status-label"
                    text="Battle will begin shortly..."
                    AnchorPane.bottomAnchor="5" AnchorPane.leftAnchor="20"
                    AnchorPane.rightAnchor="20" />

            </AnchorPane>
        </StackPane>
        <StackPane fx:id="optionsSection" styleClass="options-section" maxWidth="420" minWidth="340">

            <Region styleClass="options-bg-pattern" />

            <VBox alignment="CENTER" spacing="16" styleClass="options-content">
                <padding>
                    <Insets top="24" bottom="24" left="20" right="20" />
                </padding>

                <VBox fx:id="playerPokemonBox" managed="false" visible="false" />
                <VBox fx:id="opponentPokemonBox" managed="false" visible="false" />
                <Label fx:id="playerNameLabel" managed="false" visible="false" />
                <Label fx:id="opponentNameLabel" managed="false" visible="false" />
                <Label fx:id="playerTeamLabel" managed="false" visible="false" />
                <Label fx:id="opponentTeamLabel" managed="false" visible="false" />

                <VBox fx:id="actionButtonsBox" alignment="CENTER" spacing="20" managed="true"
                    visible="true">

                    <Button fx:id="attackButton" text="FIGHT" styleClass="fight-btn"
                        prefWidth="260" prefHeight="110">
                        <font>
                            <Font name="System Bold" size="28" />
                        </font>
                    </Button>

                    <!-- Smaller action row -->
                    <HBox alignment="CENTER" spacing="14">
                        <Button fx:id="startBattleButton" text="START BATTLE"
                            styleClass="option-btn, option-btn-green"
                            prefWidth="150" prefHeight="50" visible="false" managed="false">
                            <font>
                                <Font size="13" />
                            </font>
                        </Button>
                        <Button fx:id="changePokemonMainButton" text="POKéMON"
                            styleClass="option-btn, option-btn-red"
                            prefWidth="150" prefHeight="50">
                            <font>
                                <Font size="13" />
                            </font>
                        </Button>
                    </HBox>

                    <HBox alignment="CENTER" spacing="14">
                        <Button fx:id="itemsButton" text="BAG"
                            styleClass="option-btn, option-btn-yellow"
                            prefWidth="150" prefHeight="50">
                            <font>
                                <Font size="13" />
                            </font>
                        </Button>
                        <Button fx:id="backButton" text="RUN"
                            styleClass="option-btn, option-btn-blue"
                            prefWidth="150" prefHeight="50">
                            <font>
                                <Font size="13" />
                            </font>
                        </Button>
                    </HBox>
                </VBox>

                <VBox fx:id="moveSelectionBox" alignment="CENTER" spacing="8" managed="false"
                    visible="false"
                    styleClass="move-selection-box">
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10" />
                    </padding>
                    <VBox fx:id="moveButtonsContainer" alignment="CENTER" spacing="7" maxWidth="310" />
                    <Button text="← Back" styleClass="move-back-btn" onAction="#onBackToActions"
                        prefWidth="120" prefHeight="36">
                        <font>
                            <Font size="12" />
                        </font>
                    </Button>
                </VBox>

                <VBox fx:id="pokemonSelectionBox" alignment="CENTER" spacing="10" managed="false"
                    visible="false"
                    styleClass="pokemon-selection-box">
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10" />
                    </padding>
                    <Label text="Choose Pokémon:" styleClass="section-header-label" />
                    <VBox fx:id="pokemonButtonsBox" alignment="CENTER" spacing="8" />
                    <Button text="← Back" styleClass="move-back-btn" onAction="#onBackToActions"
                        prefWidth="120" prefHeight="36">
                        <font>
                            <Font size="12" />
                        </font>
                    </Button>
                </VBox>

            </VBox>

            <VBox StackPane.alignment="TOP_RIGHT" translateX="-16" translateY="16"
                spacing="8" alignment="TOP_RIGHT" pickOnBounds="false">
                <Button fx:id="battleSettingsButton" onAction="#onBattleMenuToggleClicked"
                    styleClass="hamburger-trigger"
                    pickOnBounds="true" focusTraversable="false">
                    <graphic>
                        <StackPane styleClass="hamburger-circle" mouseTransparent="true">
                            <VBox spacing="4" alignment="CENTER" mouseTransparent="true">
                                <Region styleClass="hamburger-line" />
                                <Region styleClass="hamburger-line" />
                                <Region styleClass="hamburger-line" />
                            </VBox>
                        </StackPane>
                    </graphic>
                </Button>
                <VBox fx:id="battleQuickMenu" visible="false" managed="false" spacing="8"
                    styleClass="battle-quick-menu" pickOnBounds="true">
                    <Button text="Guide" onAction="#onBattleGuideClicked"
                        styleClass="battle-quick-menu-button" prefWidth="230" prefHeight="36" />
                    <Button text="Settings" onAction="#onBattleSettingsClicked"
                        styleClass="battle-quick-menu-button" prefWidth="230" prefHeight="36" />
                    <Button text="Quit to Home" onAction="#onQuitToHomeClicked"
                        styleClass="battle-quick-menu-button" prefWidth="230" prefHeight="36" />
                    <Button text="Quit to Desktop" onAction="#onQuitToDesktopClicked"
                        styleClass="battle-quick-menu-button" prefWidth="230" prefHeight="36" />
                    <Button text="Cancel" onAction="#onBackClicked"
                        styleClass="battle-quick-menu-button, battle-quick-menu-cancel-btn"
                        prefWidth="230" prefHeight="36" />
                </VBox>
            </VBox>
        </StackPane>
    </HBox>
    <StackPane fx:id="exitOverlay" visible="false" managed="false"
        mouseTransparent="false"
        StackPane.alignment="CENTER">
        <!-- Dim backdrop -->
        <Region fx:id="exitBackdrop" styleClass="exit-backdrop"
            mouseTransparent="false" />

        <!-- Dialog card -->
        <VBox fx:id="exitDialog" styleClass="exit-dialog"
            alignment="CENTER" spacing="24"
            maxWidth="400" maxHeight="220"
            StackPane.alignment="CENTER">
            <padding>
                <Insets top="36" bottom="32" left="36" right="36" />
            </padding>

            <Label text="Exit Game?" styleClass="exit-dialog-title" />
            <Label text="Are you sure you want to quit?" styleClass="exit-dialog-body" />

            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="exitYesButton" text="Yes"
                    styleClass="exit-btn-yes"
                    onAction="#onExitConfirmed" />
                <Button fx:id="exitNoButton" text="No"
                    styleClass="exit-btn-no"
                    onAction="#onExitCancelled" />
            </HBox>
        </VBox>
    </StackPane>
    
    <!-- VS INTRO SCREEN -->
    <AnchorPane fx:id="vsScreenPane">
        <ImageView fx:id="vsBgImage" pickOnBounds="true" preserveRatio="false"
            AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0">
            <image>
                <Image url="@../assets/fight.png" />
            </image>
        </ImageView>
        <ImageView fx:id="vsPlayerSprite"
            fitWidth="450" fitHeight="420"
            preserveRatio="true" smooth="true"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0" />
        <ImageView fx:id="vsOpponentSprite"
            fitWidth="450" fitHeight="420"
            preserveRatio="true" smooth="true"
            AnchorPane.topAnchor="-20"
            AnchorPane.rightAnchor="0" />
    </AnchorPane>

    <!-- FORCED SWITCH OVERLAY — shown when player's pokemon faints   -->
    <StackPane fx:id="forcedSwitchOverlay" visible="false" managed="false"
        style="-fx-background-color: rgba(0,0,0,0.72);"
        StackPane.alignment="CENTER">

        <VBox alignment="CENTER" spacing="0"
            maxWidth="680" minWidth="520"
            style="-fx-background-color: rgba(18,32,28,0.97);
                     -fx-background-radius: 18;
                     -fx-border-color: rgba(120,200,80,0.45);
                     -fx-border-radius: 18;
                     -fx-border-width: 2;">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="6"
                style="-fx-background-color: rgba(200,60,60,0.22);
                         -fx-background-radius: 16 16 0 0;
                         -fx-padding: 18 24 14 24;
                         -fx-border-color: transparent transparent rgba(255,255,255,0.10) transparent;
                         -fx-border-width: 0 0 1 0;">
                <Label text="⚠  Choose your next Pokémon"
                    style="-fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-text-fill: rgba(255,160,80,0.90);
                           -fx-font-family: 'SPACE NOVA';" />
                <Label fx:id="forcedSwitchTitleLabel" text="Your Pokémon fainted!"
                    style="-fx-font-size: 22px; -fx-font-weight: bold;
                           -fx-text-fill: white;
                           -fx-font-family: 'SPACE NOVA';" />
                <Label text="Select a replacement to continue the battle."
                    style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.55);" />
            </VBox>

            <!-- Scrollable pokemon list -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                maxHeight="440"
                style="-fx-background: transparent; -fx-background-color: transparent;
                               -fx-padding: 0;">
                <VBox fx:id="forcedSwitchPokemonList" spacing="10" alignment="TOP_CENTER"
                    style="-fx-padding: 14 20 14 20;" />
            </ScrollPane>

        </VBox>
    </StackPane>

    <!-- BATTLE RESULT OVERLAY — shown after battle ends -->
    <StackPane fx:id="battleResultOverlay" visible="false" managed="false"
        style="-fx-background-color: rgba(0,0,0,0.60);">
        <VBox fx:id="battleResultCard" alignment="CENTER" spacing="20"
            maxWidth="560" maxHeight="300" styleClass="result-card">
            <Label fx:id="resultTitleLabel" styleClass="result-title" text="Victory!" />
            <Label fx:id="resultMessageLabel" styleClass="result-message"
                text="Congratulations! You won!"
                wrapText="true" textAlignment="CENTER" maxWidth="460" />
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="goBackResultButton" text="Go Back"
                    prefWidth="220" prefHeight="50" onAction="#onGoBackClicked"
                    styleClass="result-btn, result-btn-back" />
                <Button fx:id="battleAgainResultButton" text="Battle Again"
                    prefWidth="220" prefHeight="50" onAction="#onBattleAgainClicked"
                    styleClass="result-btn, result-btn-again-victory" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- BLACK FADE OVERLAY — covers everything during VS→Battle transition -->
    <Region fx:id="rootBlackFade"
        style="-fx-background-color: black;"
        opacity="0"
        mouseTransparent="true" />
</StackPane>