<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.media.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootPane"
           fx:controller="com.example.pokemonbattle.controller.IntroController"
           xmlns:fx="http://javafx.com/fxml"
           prefWidth="1200" prefHeight="700"
           style="-fx-background-color: black;">

    <!-- Video Layer -->
    <MediaView fx:id="mediaView"
               fitWidth="1200"
               fitHeight="700"
               preserveRatio="false"
               mouseTransparent="true"/>

    <!-- Black fade overlay (starts invisible, fades in smoothly before video ends) -->
    <Rectangle fx:id="flashOverlay"
               width="1200"
               height="700"
               fill="black"
               opacity="0"
               mouseTransparent="true"/>

</StackPane>
